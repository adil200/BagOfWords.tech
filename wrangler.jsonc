{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "bagofwords-tech",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bagofwords-db",
			"database_id": "5a905458-14cd-4ead-b5cd-9e30a7158c34"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "bagofwords-tech"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_ASSETS_URL": "https://assets.bagofwords.tech",
		"NEXT_PUBLIC_BASE_URL": "https://bagofwords.tech",
		"NEXT_PUBLIC_RAZORPAY_KEY_ID": "rzp_live_Si3F6N604LNJLE",
		"NEXT_PUBLIC_SITE_URL": "https://bagofwords.tech",
		"OWNER_EMAIL": "adil@bagofwords.tech",
		"SENDER_EMAIL": "noreply@bagofwords.tech"
	}
}